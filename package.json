{
  "name": "nameplate",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run build && node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
